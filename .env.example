# ───────────── Database ─────────────
# Empty = a SQLite file at $DATA_DIR/portfolio.db (created automatically)
# Serverless hosts (Vercel, Netlify): use a Turso / libSQL URL + token
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ───────────── Auth ─────────────
# Long random string (setup generates one). REQUIRED in production.
AUTH_SECRET=
# First admin account — created on first start (any host) or by `npm run setup`, only if no admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ───────────── Where runtime data lives ─────────────
# Database file, uploads and backups. Must survive redeploys (VPS: /var/lib/portfolio · Docker: /app/data).
DATA_DIR=

# ───────────── File storage (auto: Blob if token set, S3 if bucket set, else local disk) ─────────────
STORAGE_DRIVER=
# Vercel Blob (Vercel)
BLOB_READ_WRITE_TOKEN=
# Any S3-compatible bucket: AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ───────────── AI assistant ─────────────
# Optional: separate key for encrypting the AI API keys you save in Admin → AI (otherwise AUTH_SECRET is used).
# Changing it means re-entering your AI keys. The AI keys themselves are entered in the admin panel, not here.
AI_ENCRYPTION_KEY=

# ───────────── Email (optional) ─────────────
# Resend API key — password-reset emails, tester invites, new-message alerts. Without it, emails are skipped.
# Your domain must be verified in Resend (DNS records). See docs/EMAIL-AND-ACCESS.md.
RESEND_API_KEY=
# Optional sender, e.g. "Your Name <noreply@yourdomain.com>" (default: noreply@<domain of SITE_URL>)
EMAIL_FROM=

# ───────────── Google sign-in (optional) ─────────────
# OAuth "Web application" client. Redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ───────────── Backups ─────────────
# Required for /api/cron/backup (Vercel Cron, GitHub Actions, crontab…). 16+ random characters.
CRON_SECRET=
# Optional separate key for server-side backup copies (otherwise AUTH_SECRET is used)
BACKUP_SECRET=
# "off" disables the built-in backup timer on long-running servers
BACKUP_SCHEDULER=

# ───────────── Site ─────────────
SITE_URL=http://localhost:3000
