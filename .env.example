# ───────────── Database ─────────────
# Local: a SQLite file (created automatically by `npm run setup`)
# Production (Vercel): create a free Turso database and paste its URL + token
DATABASE_URL=file:./data/portfolio.db
DATABASE_AUTH_TOKEN=

# ───────────── Auth ─────────────
# Long random string (setup generates one). REQUIRED in production.
AUTH_SECRET=
# Used only by `npm run setup` to create the first admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ───────────── File storage ─────────────
# Empty  -> uploads are stored on disk in ./data/uploads (local / VPS / Render disk)
# Set it -> uploads go to Vercel Blob (required on Vercel, because its disk is not persistent)
BLOB_READ_WRITE_TOKEN=

# ───────────── Site ─────────────
SITE_URL=http://localhost:3000
